{
  "netlist": "../netlists/f200n64b.sp",
  "engine": "ngspice",
  "backend": "batch",
  "models": {
    "pdk": "gf180mcuD",
    "lib": "libs.tech/ngspice/sm141064.ngspice",
    "param_file": "libs.tech/ngspice/design.ngspice"
  },
  "corners": {
    "process": [
      {
        "name": "ff",
        "sections": [
          "ff",
          "res_typical",
          "moscap_typical",
          "mimcap_typical"
        ]
      },
      {
        "name": "fs",
        "sections": [
          "fs",
          "res_typical",
          "moscap_typical",
          "mimcap_typical"
        ]
      },
      {
        "name": "sf",
        "sections": [
          "sf",
          "res_typical",
          "moscap_typical",
          "mimcap_typical"
        ]
      },
      {
        "name": "ss",
        "sections": [
          "ss",
          "res_typical",
          "moscap_typical",
          "mimcap_typical"
        ]
      },
      {
        "name": "typical",
        "sections": [
          "typical",
          "res_typical",
          "moscap_typical",
          "mimcap_typical"
        ]
      }
    ],
    "temperature_c": [
      -40,
      27,
      125
    ],
    "params": {
      "vdd_val": [
        2.97,
        3.3
      ]
    }
  },
  "analysis": {
    "kind": "tran",
    "args": "5e-11 1.06e-06"
  },
  "measurements": [
    {
      "name": "tfb1",
      "spice": ".meas tran tfb1 when v(fb)='vdd_val/2' rise=1 td='tskip'",
      "unit": "s"
    },
    {
      "name": "tfb2",
      "spice": ".meas tran tfb2 when v(fb)='vdd_val/2' rise=2 td='tskip'",
      "unit": "s"
    },
    {
      "name": "tdo1",
      "spice": ".meas tran tdo1 when v(divout)='vdd_val/2' rise=1 td='tskip'",
      "unit": "s"
    },
    {
      "name": "tdo2",
      "spice": ".meas tran tdo2 when v(divout)='vdd_val/2' rise=2 td='tskip'",
      "unit": "s"
    },
    {
      "name": "ffb2",
      "spice": ".meas tran ffb2 when v(fb)='vdd_val/2' fall=2 td='tskip'",
      "unit": "s"
    },
    {
      "name": "n_fb",
      "spice": ".meas tran n_fb param='(tfb2-tfb1)/tvco'",
      "unit": "vco_periods",
      "limits": {
        "min": 63.95,
        "max": 64.05
      },
      "spec_row": "multiplication-ratio"
    },
    {
      "name": "ndo",
      "spice": ".meas tran ndo param='(tdo2-tdo1)/tvco'",
      "unit": "vco_periods",
      "limits": {
        "min": 63.95,
        "max": 64.05
      },
      "spec_row": "multiplication-ratio"
    },
    {
      "name": "t_arr",
      "spice": ".meas tran t_arr param='(tdo2-tck0)-tvco*floor((tdo2-tck0)/tvco)'",
      "unit": "s"
    },
    {
      "name": "t_rtcq",
      "spice": ".meas tran t_rtcq param='(tfb2-tck0)-tvco*floor((tfb2-tck0)/tvco)'",
      "unit": "s"
    },
    {
      "name": "fbpw",
      "spice": ".meas tran fbpw param='ffb2-tfb2'",
      "unit": "s"
    },
    {
      "name": "iavg",
      "spice": ".meas tran iavg avg i(vdiv) from='tskip' to='ktstop'",
      "unit": "A"
    },
    {
      "name": "setup_margin",
      "spice": ".meas tran setup_margin param='tvco-t_arr-tsetup_s'",
      "unit": "s",
      "limits": {
        "min": 0
      },
      "spec_row": "retiming-margin"
    },
    {
      "name": "hold_margin",
      "spice": ".meas tran hold_margin param='t_arr-thold_s'",
      "unit": "s",
      "limits": {
        "min": 0
      },
      "spec_row": "retiming-margin"
    }
  ],
  "options": {
    "timeout_s": 600,
    "stage_model_inputs": true,
    "pdk_revision": "open_pdks f6eeac7dad085ffcc829ccfd721f7b4ce39edcf7"
  },
  "batch": {
    "capacity_wait_s": 600,
    "max_units_per_job": 4
  },
  "exclude": [
    {
      "process": "ff",
      "temperature_c": -40,
      "params": {
        "vdd_val": 2.97
      }
    },
    {
      "process": "ff",
      "params": {
        "vdd_val": 3.3
      }
    },
    {
      "process": "fs",
      "params": {
        "vdd_val": 3.3
      }
    },
    {
      "process": "sf",
      "temperature_c": -40,
      "params": {
        "vdd_val": 2.97
      }
    },
    {
      "process": "sf",
      "params": {
        "vdd_val": 3.3
      }
    },
    {
      "process": "sf",
      "temperature_c": 27,
      "params": {
        "vdd_val": 2.97
      }
    },
    {
      "process": "ss",
      "params": {
        "vdd_val": 3.3
      }
    },
    {
      "process": "typical",
      "temperature_c": -40,
      "params": {
        "vdd_val": 3.3
      }
    },
    {
      "process": "typical",
      "temperature_c": 125,
      "params": {
        "vdd_val": 3.3
      }
    }
  ]
}

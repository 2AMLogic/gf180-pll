*.raw
*.log
# Per-corner ngspice logs under sim/ are committed evidence, not scratch output
# — see the retention policy in sim/README.md. This negation is deliberately
# narrow: only sim/<slug>/corners/<record-id>/*.log is un-ignored; *.raw and
# stray *.log files anywhere else in the tree stay ignored.
!sim/*/corners/**/*.log
# Same story for layout/'s DRC/LVS proof evidence (layout/README.md): the
# captured deck stdout under layout/evidence/inv-tb-proof/ is the evidence,
# not scratch output.
!layout/evidence/inv-tb-proof/**/*.log
# Same story again for the floorplan skeleton's DRC evidence (issue #17).
!layout/evidence/floorplan-skeleton/**/*.log
# Same story again for the VCO ring block's real-layout DRC evidence (issue #293).
!layout/evidence/vco-layout/**/*.log
# Same story again for the lock_detector block layout's DRC evidence (issue #296).
!layout/evidence/lock-detector-layout/**/*.log
# Same story again for the PFD/CP devgen methodology proof's DRC+LVS evidence (issue #299).
!layout/evidence/pfdcp-inv-proof/**/*.log
# Same story again for the PFD block layout's DRC evidence (issue #300).
!layout/evidence/pfd-layout/**/*.log
# Same story again for the cp_dumpbuf block layout's DRC evidence (issue #302).
!layout/evidence/cp-dumpbuf-layout/**/*.log
# Same story again for the dff_tg_3v3 composite layout's DRC+LVS evidence (issue #308).
!layout/evidence/divider-dff-proof/**/*.log
# Same story again for the divider_chain devgen proofs' DRC+LVS evidence
# (issues #306, #307). #306's two directories predate this rule -- their logs
# are already tracked, so they stayed committed without one; this pattern
# makes the intent explicit for the whole family rather than relying on a
# future `git add -f`.
!layout/evidence/divider-inv-proof/**/*.log
!layout/evidence/divider-tgate-proof/**/*.log
!layout/evidence/divider-rowcells-proof/**/*.log
# Same story again for the cp_leg_n/cp_leg_p composite layout's DRC+LVS
# evidence (issue #319).
!layout/evidence/cp-leg-proof/**/*.log
# Same story again for the assembled divider_chain block layout's DRC+LVS
# evidence (issue #310).
!layout/evidence/divider-chain-layout/**/*.log
__pycache__/
.DS_Store

# ngspice corner-sweep scratch (generated decks, per-run logs, raw data).
# Committed evidence lives in sim/*/corners/<record-id>/ (see sim/README.md).
# The trailing `*` matters: a campaign with more than one testbench keeps a
# scratch tree per testbench (work-supply/, work-stages/, ...), and a bare
# `work/` rule would silently let those be committed by `git add -A`.
sim/*/work/
sim/*/work-*/

# sim/harness PDK resolution (sim/harness/pdk.py): machine-local override,
# never committed -- see sim/pdk.json for the committed defaults.
sim/pdk.local.json

# layout/'s DRC/LVS harness scratch (generated main.drc templates, re-run
# work trees). Committed evidence lives in layout/evidence/inv-tb-proof/ --
# see layout/README.md.
layout/evidence/work/

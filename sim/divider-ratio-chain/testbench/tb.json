    },
    "tfb2": {
      "analysis": "tran",
      "expr": "when v(fb)='vdd_val/2' rise=2 td='tskip'"
    },
    "n_fb": {
      "analysis": "tran",
      "expr": "param='(tfb2-tfb1)/tvco'"
    },
    "tdo1": {
      "analysis": "tran",
      "expr": "when v(divout)='vdd_val/2' rise=1 td='tskip'"
    },
    "tdo2": {
      "analysis": "tran",
      "expr": "when v(divout)='vdd_val/2' rise=2 td='tskip'"
    },
    "ndo": {
      "analysis": "tran",
      "expr": "param='(tdo2-tdo1)/tvco'"
    },
    "t_arr": {
      "analysis": "tran",
      "expr": "param='(tdo2-tck0)-tvco*floor((tdo2-tck0)/tvco)'"
    },
    "t_rtcq": {
      "analysis": "tran",
      "expr": "param='(tfb2-tck0)-tvco*floor((tfb2-tck0)/tvco)'"
    },
    "ffb2": {
      "analysis": "tran",
      "expr": "when v(fb)='vdd_val/2' fall=2 td='tskip'"
    },
    "fbpw": {
      "analysis": "tran",
      "expr": "param='ffb2-tfb2'"
    },
    "iavg": {
      "analysis": "tran",
      "expr": "avg i(vdiv) from='tskip' to='ktstop'"
    }
  },
  "checks": {
    "ratio_pass": {
      "min": 1.0
    }
  },
  "derived": {
    "module": "derive.py",
    "measures": [
      "ratio_pass",
      "fbpw_s",
      "n_target"
    ],
    "tables": [
      "retiming_margin"
    ],
    "joins": {
      "dff": "divider-ratio-dff/corners/<record-id>/dff_setup_hold.csv"
    }
  }
}

#!/usr/bin/env python3
"""gh-cached: TTL-based LRU cache wrapper for the GitHub CLI.

Drop-in replacement for `gh` that caches read-only command responses
to reduce API calls. Mutations bypass the cache and invalidate
related entries.

Cache is file-backed under /tmp/gh-cache/ for cross-process sharing, and is
partitioned per target repository: entries live in
/tmp/gh-cache/<repo-slug>/ and the repo scope is also mixed into the cache
key. Two different repositories issuing the byte-identical `gh` argv (e.g.
the Loom queue listing `gh pr list --label=loom:review-requested --state=open
--limit 500`, which is identical in every Loom-templated repo) therefore
never share an entry. Two worktrees of the *same* repository still do share,
because the scope is the resolved remote (owner/repo), not the cwd.

Usage:
    gh-cached issue view 42 --json labels
    gh-cached pr list --label "loom:review-requested" --state open
    gh-cached --no-cache issue view 42 --json labels  # bypass cache
    gh-cached --clear-cache                            # clear this repo's entries
    gh-cached --clear-cache --all                      # clear every repo's entries
    gh-cached --cache-stats                            # show hit/miss statistics
    gh-cached --cache-scope                            # print the resolved repo scope

Environment:
    GH_CACHE_DIR       Cache base directory (default: /tmp/gh-cache).
                       Per-repo subdirectories are created underneath it.
    GH_CACHE_TTL       Default TTL in seconds (default: 30)
    GH_CACHE_MAX_SIZE  Max cached entries (default: 256, per repo)
    GH_CACHE_DISABLE   Set to "1" to disable caching entirely
    GH_CACHE_DEBUG     Set to "1" for debug logging to stderr
    GH_CACHE_SCOPE     Force the repo scope string (advanced/testing only —
                       normally derived from GH_REPO or the git remote)
    GH_REPO / GH_HOST  Honored when resolving the repo scope, matching how
                       `gh` itself picks its target repository.
"""

from __future__ import annotations

import hashlib
import json
import os
import re
import subprocess
import sys
import time

# ─── Configuration ──────────────────────────────────────────────────────────

CACHE_BASE_DIR = os.environ.get("GH_CACHE_DIR", "/tmp/gh-cache")
DEFAULT_TTL = int(os.environ.get("GH_CACHE_TTL", "30"))
MAX_CACHE_SIZE = int(os.environ.get("GH_CACHE_MAX_SIZE", "256"))
CACHE_DISABLED = os.environ.get("GH_CACHE_DISABLE", "") == "1"
DEBUG = os.environ.get("GH_CACHE_DEBUG", "") == "1"

# TTL overrides by command type (seconds)
TTL_BY_COMMAND = {
    ("issue", "view"):   30,
    ("issue", "list"):   30,
    ("pr", "view"):      30,
    ("pr", "list"):      30,
    ("api",):            30,
}

# Commands that are read-only and safe to cache
CACHEABLE_SUBCOMMANDS = frozenset({"view", "list", "search", "status"})

# Commands that mutate state — bypass cache and invalidate
MUTATION_SUBCOMMANDS = frozenset({
    "edit", "create", "delete", "close", "reopen",
    "merge", "review", "comment", "label",
})

# Top-level gh commands that are never cached
PASSTHROUGH_COMMANDS = frozenset({
    "auth", "config", "ssh-key", "gpg-key", "secret",
    "repo", "gist", "extension", "alias", "completion",
    "help", "--help", "-h", "--version",
})

# ─── Repo Scoping ───────────────────────────────────────────────────────────
#
# The cache is shared across processes via a well-known /tmp path, so every
# checkout on the host reads and writes the same store. `gh` resolves its
# target repository from GH_REPO or from the git remote of the cwd — so the
# cache must
# resolve the *same* identity, or two repos issuing identical argv collide and
# one is served the other's response.
#
# Resolution is deliberately subprocess-free (plain file reads of git's own
# config), so it costs microseconds rather than the ~hundreds of milliseconds a
# `gh repo view` would add to every call — which would defeat the purpose of a
# cache whose whole job is to be faster than invoking `gh`. It is also resolved
# per process from the live cwd, so it cannot go stale across a `cd`.

# Remote name preference, mirroring how `gh` picks a base repo when several
# remotes exist (an explicit `gh-resolved = base` marker wins outright).
_REMOTE_PREFERENCE = ("upstream", "github", "origin")

_SLUG_UNSAFE = re.compile(r"[^A-Za-z0-9._-]+")


def _find_git_common_dir(start: str) -> str | None:
    """Locate the git *common* dir for `start` (shared by all worktrees).

    Returns None when `start` is not inside a git repository. Linked worktrees
    have a `.git` *file* pointing at `<main>/.git/worktrees/<name>`, whose
    `commondir` points back at the shared `<main>/.git` — so every worktree of
    a repo resolves to the same directory, and therefore the same cache scope.
    """
    env_dir = os.environ.get("GIT_DIR")
    if env_dir:
        return _resolve_common_dir(os.path.abspath(env_dir))

    d = os.path.abspath(start)
    while True:
        candidate = os.path.join(d, ".git")
        if os.path.isdir(candidate):
            return _resolve_common_dir(candidate)
        if os.path.isfile(candidate):
            try:
                with open(candidate) as f:
                    content = f.read().strip()
            except OSError:
                return None
            if content.startswith("gitdir:"):
                gitdir = content[len("gitdir:"):].strip()
                if not os.path.isabs(gitdir):
                    gitdir = os.path.join(d, gitdir)
                return _resolve_common_dir(os.path.normpath(gitdir))
            return None
        parent = os.path.dirname(d)
        if parent == d:
            return None
        d = parent


def _resolve_common_dir(gitdir: str) -> str:
    commondir_file = os.path.join(gitdir, "commondir")
    try:
        with open(commondir_file) as f:
            rel = f.read().strip()
    except OSError:
        return gitdir
    if not rel:
        return gitdir
    if not os.path.isabs(rel):
        rel = os.path.join(gitdir, rel)
    return os.path.normpath(rel)


def _parse_git_remotes(common_dir: str) -> tuple[dict[str, str], str | None]:
    """Return ({remote_name: url}, resolved_base_remote_or_None)."""
    urls: dict[str, str] = {}
    resolved: str | None = None
    section: str | None = None
    try:
        with open(os.path.join(common_dir, "config")) as f:
            lines = f.readlines()
    except OSError:
        return urls, resolved

    for line in lines:
        line = line.strip()
        if not line or line.startswith("#") or line.startswith(";"):
            continue
        if line.startswith("[") and line.endswith("]"):
            section = line[1:-1].strip()
            continue
        if section is None or "=" not in line:
            continue
        low = section.lower()
        if not (low.startswith("remote ") or low == "remote"):
            continue
        parts = section.split(None, 1)
        if len(parts) < 2:
            continue
        name = parts[1].strip().strip('"')
        key, value = line.split("=", 1)
        key = key.strip().lower()
        value = value.strip()
        if key == "url":
            urls.setdefault(name, value)
        elif key == "gh-resolved" and value == "base":
            resolved = name
    return urls, resolved


def _normalize_repo_spec(spec: str, default_host: str) -> str | None:
    """Normalize GH_REPO / a git remote URL to a stable `host/owner/repo`."""
    spec = spec.strip()
    if not spec:
        return None

    host = default_host
    path = spec
    bare = False  # no scheme and no user@host — i.e. "OWNER/REPO" style

    # scp-style: git@github.com:owner/repo.git
    if "://" not in spec and "@" in spec and ":" in spec.split("@", 1)[1]:
        hostpart, path = spec.split("@", 1)[1].split(":", 1)
        host = hostpart
    elif "://" in spec:
        rest = spec.split("://", 1)[1]
        if "@" in rest.split("/", 1)[0]:
            rest = rest.split("@", 1)[1]
        hostpart, _, path = rest.partition("/")
        host = hostpart
    else:
        bare = True
        # A local filesystem remote is not an owner/repo identity — let the
        # caller fall back to path-based scoping rather than inventing an
        # owner/repo out of directory names (which can collide).
        if spec.startswith(("/", ".", "~")):
            return None

    host = host.split(":")[0].lower()
    path = path.strip("/")
    if path.endswith(".git"):
        path = path[: -len(".git")]

    segments = [s for s in path.split("/") if s]
    if len(segments) < 2:
        return None
    if bare:
        # GH_REPO accepts OWNER/REPO or HOST/OWNER/REPO — nothing longer.
        if len(segments) > 3:
            return None
        if len(segments) == 3:
            host = segments[0].split(":")[0].lower()

    owner, repo = segments[-2], segments[-1]
    if not host:
        return None

    return f"{host.lower()}/{owner.lower()}/{repo.lower()}"


def resolve_repo_scope() -> str:
    """Resolve the repository this invocation targets, as a stable string.

    Precedence mirrors `gh`'s own target resolution:
      1. GH_CACHE_SCOPE  — explicit override (advanced / testing)
      2. GH_REPO         — what `gh` itself honors first
      3. the git remote of the cwd's repository (shared across worktrees)
      4. the git common dir path — isolates checkouts with no usable remote
      5. the cwd — last resort outside any git repository

    Levels 4 and 5 are deliberately *coarser but never shared*: an
    unidentifiable repo gets its own partition rather than falling into a
    common one where it could collide with another unidentifiable repo.
    """
    forced = os.environ.get("GH_CACHE_SCOPE", "").strip()
    if forced:
        return f"scope:{forced}"

    default_host = (os.environ.get("GH_HOST", "") or "github.com").strip().lower()

    gh_repo = os.environ.get("GH_REPO", "").strip()
    if gh_repo:
        normalized = _normalize_repo_spec(gh_repo, default_host)
        if normalized:
            return f"repo:{normalized}"

    try:
        cwd = os.getcwd()
    except OSError:
        return "path:unknown"

    common_dir = _find_git_common_dir(cwd)
    if common_dir:
        urls, resolved = _parse_git_remotes(common_dir)
        candidates: list[str] = []
        if resolved:
            candidates.append(resolved)
        candidates.extend(_REMOTE_PREFERENCE)
        candidates.extend(sorted(urls))
        for name in candidates:
            if name in urls:
                normalized = _normalize_repo_spec(urls[name], default_host)
                if normalized:
                    return f"repo:{normalized}"
        return f"path:{os.path.realpath(common_dir)}"

    return f"path:{os.path.realpath(cwd)}"


def scope_slug(scope: str) -> str:
    """Filesystem-safe, collision-free directory name for a repo scope.

    Readable prefix (so `ls /tmp/gh-cache` is diagnosable) plus a hash of the
    full scope, so two scopes that sanitize to the same prefix still get
    distinct directories.
    """
    digest = hashlib.sha256(scope.encode()).hexdigest()[:12]
    readable = _SLUG_UNSAFE.sub("_", scope).strip("_")[-60:].strip("_")
    return f"{readable}-{digest}" if readable else digest


REPO_SCOPE = resolve_repo_scope()
CACHE_DIR = os.path.join(CACHE_BASE_DIR, scope_slug(REPO_SCOPE))


# ─── Cache Implementation ───────────────────────────────────────────────────

def debug(msg: str) -> None:
    if DEBUG:
        print(f"[gh-cached] {msg}", file=sys.stderr)


def ensure_cache_dir() -> None:
    # Create each level 0700-only: the base lives in a world-writable /tmp, so
    # it must not be left group/other-accessible for other users to read one
    # repo's cached API responses out of.
    for path in (CACHE_BASE_DIR, CACHE_DIR):
        os.makedirs(path, mode=0o700, exist_ok=True)
        try:
            os.chmod(path, 0o700)
        except OSError:
            pass


def cache_key(args: list[str]) -> str:
    """Generate a cache key from the repo scope plus the gh arguments.

    The repo scope is part of the hashed input (not just the directory name)
    so identical argv from two different repositories can never collide even
    if the partition directories are bypassed. NUL-joining the arguments also
    keeps `["a b", "c"]` distinct from `["a", "b c"]`.
    """
    raw = "\x00".join([REPO_SCOPE, *args])
    return hashlib.sha256(raw.encode()).hexdigest()[:16]


def cache_path(key: str) -> str:
    return os.path.join(CACHE_DIR, f"{key}.json")


def stats_path() -> str:
    return os.path.join(CACHE_DIR, "_stats.json")


def read_stats() -> dict:
    path = stats_path()
    try:
        with open(path) as f:
            return json.load(f)
    except (FileNotFoundError, json.JSONDecodeError):
        return {"hits": 0, "misses": 0, "bypasses": 0, "invalidations": 0}


def write_stats(stats: dict) -> None:
    ensure_cache_dir()
    path = stats_path()
    try:
        with open(path, "w") as f:
            json.dump(stats, f)
    except OSError:
        pass


def increment_stat(stat_name: str) -> None:
    stats = read_stats()
    stats[stat_name] = stats.get(stat_name, 0) + 1
    write_stats(stats)


def cache_get(key: str) -> tuple[str | None, int | None]:
    """Read a cached entry. Returns (stdout, returncode) or (None, None) if miss."""
    path = cache_path(key)
    try:
        with open(path) as f:
            entry = json.load(f)
        if time.time() - entry["time"] > entry["ttl"]:
            debug(f"EXPIRED key={key}")
            os.unlink(path)
            return None, None
        # Update access time for LRU
        entry["accessed"] = time.time()
        with open(path, "w") as f:
            json.dump(entry, f)
        return entry["stdout"], entry["returncode"]
    except (FileNotFoundError, json.JSONDecodeError, KeyError):
        return None, None


def cache_put(key: str, stdout: str, returncode: int, ttl: int, args: list[str] | None = None) -> None:
    """Write a cache entry."""
    ensure_cache_dir()
    enforce_max_size()
    entry = {
        "time": time.time(),
        "accessed": time.time(),
        "ttl": ttl,
        "stdout": stdout,
        "returncode": returncode,
        "args": args or [],
    }
    path = cache_path(key)
    try:
        with open(path, "w") as f:
            json.dump(entry, f)
    except OSError:
        pass


def enforce_max_size() -> None:
    """Evict least-recently-accessed entries if cache exceeds max size."""
    try:
        entries = []
        for name in os.listdir(CACHE_DIR):
            if name.startswith("_") or not name.endswith(".json"):
                continue
            path = os.path.join(CACHE_DIR, name)
            try:
                with open(path) as f:
                    data = json.load(f)
                entries.append((data.get("accessed", 0), path))
            except (json.JSONDecodeError, OSError):
                # Corrupted entry — remove it
                os.unlink(path)

        if len(entries) <= MAX_CACHE_SIZE:
            return

        # Sort by access time, evict oldest
        entries.sort(key=lambda x: x[0])
        evict_count = len(entries) - MAX_CACHE_SIZE
        for _, path in entries[:evict_count]:
            debug(f"EVICT {os.path.basename(path)}")
            os.unlink(path)
    except OSError:
        pass


def invalidate_for_resource(resource_type: str, resource_id: str | None) -> None:
    """Invalidate cached entries related to a resource.

    After a mutation like `gh issue edit 42 ...`, we invalidate any cached
    entries whose original command args reference the same resource type and id.
    Falls back to checking stdout for backward compatibility with cache entries
    that predate the args field.
    """
    if not resource_id:
        return

    debug(f"INVALIDATE {resource_type} {resource_id}")
    count = 0
    try:
        for name in os.listdir(CACHE_DIR):
            if name.startswith("_") or not name.endswith(".json"):
                continue
            path = os.path.join(CACHE_DIR, name)
            try:
                with open(path) as f:
                    data = json.load(f)
                args = data.get("args", [])
                # Primary: check if the cached command's args reference this resource
                if args and resource_type in args and resource_id in args:
                    debug(f"INVALIDATE (args match) {name}")
                    os.unlink(path)
                    count += 1
                    continue
                # Fallback: check stdout for backward compatibility with
                # cache entries that don't have stored args
                stdout = data.get("stdout", "")
                if resource_id in stdout:
                    debug(f"INVALIDATE (stdout match) {name}")
                    os.unlink(path)
                    count += 1
            except (json.JSONDecodeError, OSError):
                try:
                    os.unlink(path)
                except OSError:
                    pass
    except OSError:
        pass

    if count:
        debug(f"INVALIDATED {count} entries for {resource_type} {resource_id}")
        stats = read_stats()
        stats["invalidations"] = stats.get("invalidations", 0) + count
        write_stats(stats)


def invalidate_all_for_type(resource_type: str) -> None:
    """Broad invalidation: clear all entries when we can't determine the resource id."""
    debug(f"INVALIDATE ALL (mutation on {resource_type})")
    clear_cache()


def clear_cache() -> None:
    """Remove all cached entries for the current repo scope."""
    try:
        for name in os.listdir(CACHE_DIR):
            if name.startswith("_"):
                continue
            path = os.path.join(CACHE_DIR, name)
            os.unlink(path)
    except OSError:
        pass


def clear_all_caches() -> None:
    """Remove cached entries for every repo scope under the cache base dir.

    Also sweeps any un-partitioned entries sitting directly in the base dir:
    those are pre-repo-scoping leftovers, which are never read any more but are
    exactly the cross-repo-contaminated ones worth removing.
    """
    try:
        partitions = os.listdir(CACHE_BASE_DIR)
    except OSError:
        return
    for partition in partitions:
        part_dir = os.path.join(CACHE_BASE_DIR, partition)
        if not os.path.isdir(part_dir):
            if partition.endswith(".json") and not partition.startswith("_"):
                try:
                    os.unlink(part_dir)
                except OSError:
                    pass
            continue
        try:
            for name in os.listdir(part_dir):
                if name.startswith("_"):
                    continue
                try:
                    os.unlink(os.path.join(part_dir, name))
                except OSError:
                    pass
        except OSError:
            pass


# ─── Command Analysis ────────────────────────────────────────────────────────

def parse_gh_args(args: list[str]) -> dict:
    """Parse gh command arguments to determine cacheability.

    Returns dict with:
        resource_type: "issue", "pr", "api", etc.
        subcommand: "view", "list", "edit", etc.
        resource_id: The issue/PR number if present
        cacheable: Whether this command can be cached
        ttl: TTL to use for this command
    """
    result = {
        "resource_type": None,
        "subcommand": None,
        "resource_id": None,
        "cacheable": False,
        "ttl": DEFAULT_TTL,
    }

    if not args:
        return result

    # First non-flag arg is the resource type
    resource_type = args[0]
    result["resource_type"] = resource_type

    if resource_type in PASSTHROUGH_COMMANDS:
        return result

    # Special case: `gh api` — cache GET requests
    if resource_type == "api":
        result["subcommand"] = "api"
        # Check for method flags that indicate mutation
        is_mutation = False
        for i, arg in enumerate(args):
            if arg in ("-X", "--method") and i + 1 < len(args):
                method = args[i + 1].upper()
                if method != "GET":
                    is_mutation = True
                    break
            if arg == "-f" or arg == "--field":
                # POST with fields
                is_mutation = True
                break
        if not is_mutation:
            result["cacheable"] = True
            result["ttl"] = TTL_BY_COMMAND.get(("api",), DEFAULT_TTL)
        return result

    # Second arg is the subcommand
    if len(args) < 2:
        return result

    subcommand = args[1]
    result["subcommand"] = subcommand

    # Extract resource ID (first non-flag arg after subcommand)
    for arg in args[2:]:
        if not arg.startswith("-"):
            result["resource_id"] = arg
            break

    # Determine TTL
    ttl_key = (resource_type, subcommand)
    result["ttl"] = TTL_BY_COMMAND.get(ttl_key, DEFAULT_TTL)

    # Determine cacheability
    if subcommand in CACHEABLE_SUBCOMMANDS:
        result["cacheable"] = True
    elif subcommand in MUTATION_SUBCOMMANDS:
        result["cacheable"] = False

    return result


# ─── Main ────────────────────────────────────────────────────────────────────

def run_gh(args: list[str]) -> tuple[str, str, int]:
    """Execute the real gh command and return (stdout, stderr, returncode)."""
    proc = subprocess.run(
        ["gh"] + args,
        capture_output=True,
        text=True,
    )
    return proc.stdout, proc.stderr, proc.returncode


def main() -> int:
    args = sys.argv[1:]

    # Handle meta-commands
    if "--cache-scope" in args:
        print(REPO_SCOPE)
        print(CACHE_DIR)
        return 0

    if "--clear-cache" in args:
        if "--all" in args:
            clear_all_caches()
            print(f"Cache cleared for all repos under {CACHE_BASE_DIR}.", file=sys.stderr)
        else:
            clear_cache()
            print(f"Cache cleared for {REPO_SCOPE}.", file=sys.stderr)
        return 0

    if "--cache-stats" in args:
        stats = read_stats()
        total = stats["hits"] + stats["misses"]
        rate = (stats["hits"] / total * 100) if total > 0 else 0
        print(f"Scope: {REPO_SCOPE}", file=sys.stderr)
        print(f"Hits: {stats['hits']}", file=sys.stderr)
        print(f"Misses: {stats['misses']}", file=sys.stderr)
        print(f"Bypasses: {stats['bypasses']}", file=sys.stderr)
        print(f"Invalidations: {stats['invalidations']}", file=sys.stderr)
        print(f"Hit rate: {rate:.1f}%", file=sys.stderr)
        return 0

    # Handle --no-cache flag
    no_cache = False
    if "--no-cache" in args:
        args.remove("--no-cache")
        no_cache = True

    # Disabled or passthrough
    if CACHE_DISABLED or no_cache or not args:
        stdout, stderr, rc = run_gh(args)
        sys.stdout.write(stdout)
        sys.stderr.write(stderr)
        if no_cache:
            increment_stat("bypasses")
        return rc

    parsed = parse_gh_args(args)
    debug(f"CMD: gh {' '.join(args)}")
    debug(f"SCOPE: {REPO_SCOPE} dir={CACHE_DIR}")
    debug(f"PARSED: cacheable={parsed['cacheable']} type={parsed['resource_type']} "
          f"sub={parsed['subcommand']} id={parsed['resource_id']} ttl={parsed['ttl']}")

    # Mutation: bypass cache, invalidate related entries
    if not parsed["cacheable"]:
        stdout, stderr, rc = run_gh(args)
        sys.stdout.write(stdout)
        sys.stderr.write(stderr)

        # Invalidate on successful mutations
        if rc == 0 and parsed["subcommand"] in MUTATION_SUBCOMMANDS:
            if parsed["resource_id"]:
                invalidate_for_resource(parsed["resource_type"], parsed["resource_id"])
            else:
                invalidate_all_for_type(parsed["resource_type"] or "unknown")

        increment_stat("bypasses")
        return rc

    # Read-only: check cache
    key = cache_key(args)
    cached_stdout, cached_rc = cache_get(key)

    if cached_stdout is not None:
        debug(f"HIT key={key}")
        sys.stdout.write(cached_stdout)
        increment_stat("hits")
        return cached_rc

    # Cache miss: run real command
    debug(f"MISS key={key}")
    stdout, stderr, rc = run_gh(args)
    sys.stdout.write(stdout)
    sys.stderr.write(stderr)

    # Only cache successful responses
    if rc == 0:
        cache_put(key, stdout, rc, parsed["ttl"], args=args)

    increment_stat("misses")
    return rc


if __name__ == "__main__":
    sys.exit(main())

      "expr": "min i(vam_m10) from=9.264462809917355e-08 to=9.19090909090909e-07"
    },
    "imax_m10": {
      "analysis": "tran",
      "expr": "max i(vam_m10) from=9.264462809917355e-08 to=9.19090909090909e-07"
    },
